# Copy this file to .env in the project root and replace the values below.
# Never commit .env to GitHub.

# Generate a strong Flask secret key with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=aprivatekeythatshouldnotbecommitted

# Use a private password that is not committed anywhere.
ADMIN_PASSWORD=admin@142536475869

# Keep false when using plain HTTP on a local LAN.
# Set true only if the admin site is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Admin sessions expire after this many hours.
ADMIN_SESSION_HOURS=8