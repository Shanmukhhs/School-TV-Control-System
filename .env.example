# Copy this file to .env in the project root and replace the values below.
# NEVER commit the real .env file to GitHub — it is gitignored and contains secrets.
# The values below are EXAMPLES ONLY and are intentionally fake. Do not use them.

# Generate a real, random Flask secret key with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set your real, private admin password here. This is just a placeholder.
ADMIN_PASSWORD=

# Keep false when using plain HTTP on a local LAN.
# Set true only if the admin site is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Admin sessions expire after this many hours.
ADMIN_SESSION_HOURS=8